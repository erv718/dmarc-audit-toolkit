# Copy to .env (gitignored). Never commit the real values.

# App registration for pulling hunting-query results by API.
# Read-only: Microsoft Graph application permission ThreatHunting.Read.All.
# Setup walkthrough: docs/app-registration.md
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=paste-secret-value-here

# Exchange Online app-only - only for the PowerShell auditors
# (src/audit_rules.ps1, audit_bypasses.ps1, audit_groups.ps1).
# EXO app-only needs a CERTIFICATE (client secrets do not work there) and the
# Exchange.ManageAsApp permission plus a directory role - Global Reader is
# enough for read-only. Reuses the registration above; setup: docs/app-registration.md
# EXO_APP_ID=              (defaults to AZURE_CLIENT_ID)
EXO_CERT_THUMBPRINT=
EXO_ORGANIZATION=yourtenant.onmicrosoft.com
# On macOS/Linux the scripts take a PFX file instead of the Windows cert store:
# EXO_CERT_FILE=dmarc-audit-readonly.pfx
# EXO_CERT_PASSWORD=       (only if the .pfx has one)

# AI analysis master switch (OPTIONAL - off unless you explicitly opt in).
# Anything that puts repo data in front of an AI checks this first: the MCP
# server refuses to start, and AGENTS.md tells every agent to stop, unless
# the value is exactly "true". Running the Python tools yourself needs
# nothing here - this only gates machine access by an AI client.
AI_ANALYSIS_ENABLED=false

# Aggregate (rua) report mailbox for the outside view - OPTIONAL.
# The app needs Mail.Read scoped to this one mailbox by an Application Access
# Policy (docs/app-registration.md). Leave unset to skip report ingestion.
RUA_MAILBOX=

# Slack (or Teams) incoming webhook for the weekly summary - OPTIONAL.
# collect.py posts one short message per run when this is set; --dry-run prints it.
SLACK_WEBHOOK_URL=

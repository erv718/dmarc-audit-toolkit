# credentials
.env
*.env
!.env.example

# key material never crosses into the repo (certs are uploaded to the portal
# as .cer by hand; the private halves stay on the machine that made them)
*.key
*.pfx
*.pem
*.p12

# tenant and customer data
*.csv
!samples/*.csv
exports/
audit-output/
audit-out/
audit-out-ci/
*.jsonl

# your domain-edited query copies (keep the shipped templates pristine)
queries/live/

# your private pre-push deny list (ship only the .example)
.denylist

# your settings copy (it names your domains; ship only audit.example.toml)
audit.toml

# credential material - keys and certificates never belong in the repo;
# make them under private/ (docs/app-registration.md)
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt

# python
__pycache__/
*.pyc
.venv/
venv/

# private per-machine state files (never committed)
CLAUDE.local.md
private/
